# Copy to .env and fill in. Never commit .env.

# --- Domain / HTTPS (Caddy) ---------------------------------------------------
# Public domain served by Caddy. Use "localhost" for local development.
DOMAIN=example.com
# Contact email for Let's Encrypt certificates.
ACME_EMAIL=admin@example.com
# Public URL of the frontend; Stripe redirects here after checkout and onboarding.
FRONTEND_URL=https://example.com

# --- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_DB=hackyeah
POSTGRES_USER=hackyeah
# Read only when the postgres_data volume is created for the first time.
# Use letters and digits only (it is embedded in the connection URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Only needed when running the backend outside Docker; compose builds it itself.
# CONNECTION_STRING=postgresql+asyncpg://hackyeah:<password>@localhost:5432/hackyeah

# --- Auth (JWT) ----------------------------------------------------------------
# Secret used to sign access tokens. Must be set in production:
#   openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# --- Stripe --------------------------------------------------------------------
# Dashboard -> Developers -> API keys (sk_test_... in the sandbox).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...):
#   production: Dashboard -> Workbench -> Webhooks -> endpoint
#               https://<DOMAIN>/api/payments/webhook -> Signing secret
#   local:      stripe listen --print-secret
#               (or the stripe-cli service: docker compose --profile stripe up -d)
STRIPE_WEBHOOK_SECRET=

# --- Web Push notifications (VAPID) --------------------------------------------
# Generate a key pair once, e.g.: npx web-push generate-vapid-keys
# The public key is used by the frontend to subscribe to push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, without spaces: mailto:you@example.com
VAPID_SUBJECT=mailto:admin@example.com
